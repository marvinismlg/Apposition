# Leave empty locally and on Vercel. Vite proxies /api to localhost:5219 locally;
# the repository-root vercel.json routes /api to the C# service when deployed.
VITE_API_BASE=

# Remove any previous VITE_API_BASE value from Vercel Production and Preview.
# VITE_ values are public; GEMINI_KEY belongs only on the Python backend.
