# Copy this file to .env.local in this folder and fill in your own values.
# .env.local is git-ignored: never commit a real key.

# Gemini API key from https://aistudio.google.com/apikey
GEMINI_KEY=your-gemini-api-key-here

# Optional: model to try first (default gemini-3.5-flash)
# GEMINI_MODEL=gemini-3.5-flash

# Optional: comma-separated models to try when the first is busy or out of quota
# GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-flash-latest,gemini-3.5-flash-lite
