# Python analysis API (FastAPI + sentence-transformers + Gemini).
FROM python:3.12-slim

WORKDIR /app
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/app/.cache/huggingface \
    MPLCONFIGDIR=/tmp/matplotlib \
    XDG_CACHE_HOME=/tmp/.cache

# CPU-only PyTorch: the GPU build is gigabytes larger and the server has no GPU.
# Streamlit is only for the local dashboard, so it is left out of the server image.
COPY requirements.txt .
RUN pip install torch --index-url https://download.pytorch.org/whl/cpu \
 && grep -v -i streamlit requirements.txt > requirements-server.txt \
 && pip install -r requirements-server.txt

# Bundle the same embedding model at build time so cold starts need no download.
RUN python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('all-MiniLM-L6-v2')"

# Load the bundled weights without a network check when an instance starts.
ENV HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1

COPY . .

# Vercel routes to PORT (80 by default); GEMINI_KEY is supplied at runtime.
CMD ["sh", "-c", "exec uvicorn api:app --host 0.0.0.0 --port ${PORT:-80}"]
